    },
    "The note could not be saved" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを保存できませんでした"
          }
        }
      }
    },
    "The repository choice is removed from this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリの選択がこの端末から消えます。"
          }
        }
      }
    },
    "The repository choice is removed from this device. Unsent notes and changes stay here and are sent after you sign in again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリの選択がこの端末から消えます。未送信のメモと変更は端末に残り、次にサインインしたあとに送信されます。"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日"
          }
        }
      }
    },
    "Toss in whatever comes to mind, as it is.\nArranging it can wait." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
