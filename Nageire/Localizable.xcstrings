    "OK" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "On GitHub, choose “Only select repositories” and pick the one where your notes will live. Nageire can read and write nothing else." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub で「Only select repositories」を選び、メモを保存するリポジトリを指定してください。Nageire はそれ以外を読み書きできません。"
          }
        }
      }
    },
    "Open GitHub" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub を開く"
          }
        }
      }
    },
