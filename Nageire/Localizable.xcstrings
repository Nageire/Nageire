    },
    "Enter a code on GitHub" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub でコードを入力する"
          }
        }
      }
    },
    "Enter this code on GitHub" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードを GitHub で入力してください"
          }
        }
      }
    },
    "GitHub will ask you to authorize Nageire. It can read and write only the repositories you install it on." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub で Nageire の認可を求められます。Nageire が読み書きできるのは、インストール先に選んだリポジトリだけです。"
          }
        }
      }
    },
    "Install Nageire on a repository" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nageire をリポジトリにインストール"
          }
        }
      }
    },
    "Install it on the repository for your notes" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを保存するリポジトリにインストールする"
          }
        }
      }
    },
    "Install on GitHub" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub でインストール"
          }
        }
      }
    },
    "It is deleted from the GitHub repository as well." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub のリポジトリからも削除されます。"
